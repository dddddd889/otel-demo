{
  "name": "opentelemetry-nodejs-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js + OpenTelemetry + Jaeger + Prometheus + Loki + Grafana 全栈演示",
  "main": "app.js",
  "scripts": {
    "start": "node start-services.js",
    "start:checkout": "OTEL_SERVICE_NAME=checkout-service PORT=3000 node --require ./instrumentation.js app.js",
    "start:inventory": "OTEL_SERVICE_NAME=inventory-service PORT=3002 node --require ./instrumentation.js inventory-service.js",
    "start:payment": "OTEL_SERVICE_NAME=payment-service node --require ./instrumentation.js payment-service.js",
    "check": "node --check app.js && node --check inventory-service.js && node --check payment-service.js && node --check instrumentation.js && node --check shutdown-coordinator.js && node --check start-services.js && node --check telemetry-logger.js && node --check messaging/rabbitmq-client.js && node --check messaging/message-context.js && node --check messaging/messaging-spans.js && node --check messaging/order-message.js && node --check messaging/order-publisher.js && node --check messaging/producer.js && node --check messaging/consumer.js && node --check scripts/messaging-e2e-test.js && node --check scripts/scenario-test.js && node --check scripts/sampling-test.js && node --check scripts/rabbitmq-test.js && node --check test/message-context.test.js && node --check test/messaging-spans.test.js && node --check test/payment-service.test.js",
    "test:smoke": "bash scripts/smoke-test.sh",
    "test:scenarios": "node scripts/scenario-test.js",
    "test:sampling": "node scripts/sampling-test.js",
    "test:rabbitmq": "node scripts/rabbitmq-test.js",
    "test:payment": "node --test test/payment-service.test.js",
    "test:message-context": "node --test test/message-context.test.js",
    "test:messaging-spans": "node --test test/messaging-spans.test.js",
    "test:messaging-e2e": "node scripts/messaging-e2e-test.js",
    "rabbitmq:producer": "node messaging/producer.js",
    "rabbitmq:consumer": "node messaging/consumer.js",
    "traffic": "bash scripts/generate-traffic.sh",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "amqplib": "^2.0.1",
    "express": "^5.2.1",
    "mysql2": "^3.23.4",
    "prom-client": "^15.1.3",
    "redis": "^6.2.1"
  },
  "packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620"
}
