# SDK 头部采样：保留 50% 根 Trace，并继承上游采样决定。
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.5

# 两个应用进程连接本地基础设施的地址。
INVENTORY_URL=http://localhost:3002/inventory/SKU-001
REDIS_URL=redis://localhost:6379
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=otel
MYSQL_PASSWORD=otel-demo
MYSQL_DATABASE=otel_demo

# RabbitMQ 基础消息流；后续学习提交再增加异步 Trace Context。
AMQP_URL=amqp://otel:otel-demo@localhost:5672
RABBITMQ_ORDER_QUEUE=otel.demo.orders
